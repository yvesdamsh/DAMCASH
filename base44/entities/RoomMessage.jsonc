{
  "name": "RoomMessage",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "ID du salon"
    },
    "user_id": {
      "type": "string",
      "description": "ID de l'utilisateur"
    },
    "user_name": {
      "type": "string",
      "description": "Nom de l'utilisateur"
    },
    "content": {
      "type": "string",
      "description": "Contenu du message"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "room_id",
    "user_id",
    "content"
  ]
}