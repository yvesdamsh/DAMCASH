{
  "name": "FriendRequest",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "ID du joueur qui envoie la demande"
    },
    "receiver_id": {
      "type": "string",
      "description": "ID du joueur qui re\u00e7oit la demande"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending",
      "description": "Statut de la demande d'ami"
    }
  },
  "required": [
    "sender_id",
    "receiver_id"
  ]
}